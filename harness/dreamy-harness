#!/usr/bin/env node
import { execFileSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";

const op = process.argv[2] ?? "help";
const target = path.resolve(process.argv[3] ?? ".");

function json(value, code = 0) {
  const observedAt = new Date().toISOString();
  console.log(JSON.stringify({ observedAt, timestamp: observedAt, command: process.argv.slice(1), artifacts: [], ...value, exitCode: code }, null, 2));
  process.exitCode = code;
}

function git(args) {
  try {
    return execFileSync("git", ["-c", `safe.directory=${target.replaceAll("\\", "/")}`, "-C", target, ...args], { encoding: "utf8" });
  } catch (error) {
    return error.stdout?.toString() ?? error.message;
  }
}

if (op === "git-status") {
  json({
    schemaVersion: 1,
    adapter: "dreamy-harness",
    operation: op,
    target,
    status: "pass",
    diagnostics: git(["status", "--short"]).trim().split("\n").filter(Boolean)
  });
} else if (op === "git-diff") {
  json({
    schemaVersion: 1,
    adapter: "dreamy-harness",
    operation: op,
    target,
    status: "pass",
    diagnostics: [git(["diff", "--stat"]).trim()].filter(Boolean)
  });
} else if (op === "compile" || op === "console" || op === "test-editmode" || op === "test-playmode") {
  json({
    schemaVersion: 1,
    adapter: "dreamy-harness",
    operation: op,
    target,
    status: "degraded",
    degradedReason: "Unity executable or MCP bridge not configured",
    diagnostics: [],
    errors: [],
    warnings: [],
    exceptions: []
  }, 2);
} else if (op === "project-inspect" || op === "validate-project") {
  const manifest = path.join(target, "Packages", "manifest.json");
  const lock = path.join(target, "Packages", "packages-lock.json");
  const version = path.join(target, "ProjectSettings", "ProjectVersion.txt");
  json({
    schemaVersion: 1,
    adapter: "dreamy-harness",
    operation: op,
    target,
    status: "pass",
    diagnostics: [
      fs.existsSync(manifest) ? "Packages/manifest.json present" : "Packages/manifest.json missing",
      fs.existsSync(lock) ? "Packages/packages-lock.json present" : "Packages/packages-lock.json missing",
      fs.existsSync(version) ? "ProjectVersion.txt present" : "ProjectVersion.txt missing"
    ]
  });
} else if (op === "asmdef") {
  const fixture = process.argv[3] ? path.resolve(process.argv[3]) : target;
  const text = fs.existsSync(fixture) ? fs.readFileSync(fixture, "utf8") : "";
  const unsafe = /UnityEditor|guid-unsafe|unsafe/i.test(text) || /unsafe/i.test(path.basename(fixture));
  json({
    schemaVersion: 1,
    adapter: "dreamy-harness",
    operation: op,
    target: fixture,
    status: unsafe ? "fail" : "pass",
    diagnostics: unsafe ? ["Runtime/Editor or GUID safety issue detected by static asmdef fixture"] : ["static asmdef fixture passed"]
  }, unsafe ? 1 : 0);
} else if (op === "package-check" || op === "validate-package" || op === "validate-addressables" || op === "build-android" || op === "build-ios") {
  json({
    schemaVersion: 1,
    adapter: "dreamy-harness",
    operation: op,
    target,
    status: "degraded",
    degradedReason: "Static adapter implemented; real Unity bridge pending",
    diagnostics: []
  }, 2);
} else {
  json({
    schemaVersion: 1,
    adapter: "dreamy-harness",
    operation: "help",
    status: "pass",
    operations: ["git-status", "git-diff", "compile", "console", "test-editmode", "test-playmode", "project-inspect", "asmdef", "package-check", "validate-project", "validate-package", "validate-addressables", "build-android", "build-ios"]
  });
}
