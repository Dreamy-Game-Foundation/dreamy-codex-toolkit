#!/usr/bin/env node
import { execFileSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";

const op = process.argv[2] ?? "help";
const target = path.resolve(process.argv[3] ?? ".");

function json(value, code = 0) {
  console.log(JSON.stringify({ ...value, exitCode: code }, null, 2));
  process.exitCode = code;
}

function git(args) {
  try {
    return execFileSync("git", ["-c", `safe.directory=${target.replaceAll("\\", "/")}`, "-C", target, ...args], { encoding: "utf8" });
  } catch (error) {
    return error.stdout?.toString() ?? error.message;
  }
}

if (op === "git-status") {
  json({
    schemaVersion: 1,
    adapter: "dreamy-harness",
    operation: op,
    target,
    status: "pass",
    diagnostics: git(["status", "--short"]).trim().split("\n").filter(Boolean)
  });
} else if (op === "git-diff") {
  json({
    schemaVersion: 1,
    adapter: "dreamy-harness",
    operation: op,
    target,
    status: "pass",
    diagnostics: [git(["diff", "--stat"]).trim()].filter(Boolean)
  });
} else if (op === "compile" || op === "console" || op === "test-editmode" || op === "test-playmode") {
  json({
    schemaVersion: 1,
    adapter: "dreamy-harness",
    operation: op,
    target,
    status: "degraded",
    degradedReason: "Unity executable or MCP bridge not configured",
    diagnostics: [],
    errors: [],
    warnings: [],
    exceptions: []
  }, 2);
} else if (op === "validate-project" || op === "validate-package" || op === "validate-addressables" || op === "build-android" || op === "build-ios") {
  json({
    schemaVersion: 1,
    adapter: "dreamy-harness",
    operation: op,
    target,
    status: "degraded",
    degradedReason: "Static adapter implemented; real Unity bridge pending",
    diagnostics: []
  }, 2);
} else {
  json({
    schemaVersion: 1,
    adapter: "dreamy-harness",
    operation: "help",
    status: "pass",
    operations: ["git-status", "git-diff", "compile", "console", "test-editmode", "test-playmode", "validate-project", "validate-package", "validate-addressables", "build-android", "build-ios"]
  });
}
