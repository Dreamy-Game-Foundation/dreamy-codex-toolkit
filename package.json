{
  "name": "dreamy-codex-toolkit",
  "version": "0.1.0-alpha.3",
  "private": false,
  "type": "module",
  "description": "Codex toolkit for Dreamy Unity projects and packages.",
  "scripts": {
    "validate": "node src/cli.js validate && node scripts/validate-skills.mjs && node scripts/validate-acceptance.mjs",
    "test": "npm run validate && node --test tests/unit/*.test.mjs",
    "test:node": "node --test tests/unit/*.test.mjs",
    "eval:deterministic": "node src/cli.js eval",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:selftest": "node scripts/benchmark.mjs --manifest benchmarks/manifests/selftest.json",
    "compatibility:fetch": "node scripts/compatibility-fetch.mjs",
    "compatibility:validate": "node scripts/compatibility-validate.mjs",
    "compatibility:report": "node scripts/refresh-compatibility.mjs",
    "compatibility:refresh": "npm run compatibility:fetch && npm run compatibility:validate && npm run compatibility:report",
    "release:check": "node scripts/release-check.mjs",
    "changelog": "node scripts/changelog.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs"
  },
  "bin": {
    "dreamy-kit": "src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "agents/",
    "benchmarks/adapters/",
    "benchmarks/cases/",
    "benchmarks/manifests/",
    "compatibility/",
    "docs/",
    "evals/",
    "harness/",
    "modules/",
    "presets/",
    "rules/",
    "schemas/",
    "scripts/",
    "skills/",
    "src/",
    "templates/",
    "toolkit.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "codex",
    "skills",
    "agents",
    "unity",
    "dreamy",
    "game-development"
  ],
  "homepage": "https://github.com/Dreamy-Game-Foundation/dreamy-codex-toolkit#readme",
  "bugs": {
    "url": "https://github.com/Dreamy-Game-Foundation/dreamy-codex-toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dreamy-Game-Foundation/dreamy-codex-toolkit.git"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
