{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamy.tools/codex/schemas/evidence.schema.json",
  "title": "Dreamy Evidence",
  "type": "object",
  "required": ["schemaVersion", "adapter", "operation", "status", "summary", "observedAt", "startedAt", "completedAt", "durationMs", "platform", "projectPath", "command", "exitCode", "artifacts", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "adapter": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pass", "fail", "degraded"] },
    "summary": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "minLength": 1 },
    "completedAt": { "type": "string", "minLength": 1 },
    "durationMs": { "type": "integer", "minimum": 0 },
    "platform": { "type": "string", "minLength": 1 },
    "projectPath": { "type": "string", "minLength": 1 },
    "unityVersion": { "type": ["string", "null"] },
    "unityExecutable": { "type": ["string", "null"] },
    "manifestHash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "packagesLockHash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "command": { "type": "array", "items": { "type": "string" } },
    "exitCode": { "type": ["integer", "null"] },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "diagnostics": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "git": {
      "type": "object",
      "properties": {
        "available": { "type": "boolean" },
        "dirtyPaths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "profileHash": { "type": ["string", "null"] },
    "degradedReason": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pass" } }, "required": ["status"] },
      "then": { "properties": { "exitCode": { "const": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "degraded" } }, "required": ["status"] },
      "then": { "required": ["degradedReason"], "properties": { "exitCode": { "not": { "const": 0 } }, "degradedReason": { "type": "string", "minLength": 1 } } }
    }
  ]
}
