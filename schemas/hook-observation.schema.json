{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamy.tools/codex/schemas/hook-observation.schema.json",
  "title": "Dreamy Hook Observation",
  "type": "object",
  "required": [
    "schemaVersion",
    "operation",
    "outcome"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "degraded"
      ]
    },
    "taskId": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "eventId": {
      "type": "string"
    }
  }
}
