{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamy.tools/codex/schemas/install-state.schema.json",
  "title": "Dreamy Install State",
  "type": "object",
  "required": ["schemaVersion", "toolkitVersion", "target", "preset", "resolvedModules", "skills", "agents", "managedFiles", "checksums"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "toolkitVersion": { "type": "string" },
    "target": { "type": "string" },
    "targetKind": { "enum": ["project", "global"] },
    "preset": { "type": "string" },
    "resolvedModules": { "type": "array", "items": { "type": "string" } },
    "skills": { "type": "array", "items": { "type": "string" } },
    "agents": { "type": "array", "items": { "type": "string" } },
    "managedFiles": { "type": "array", "items": { "type": "string" } },
    "checksums": { "type": "object" },
    "detectedPackages": { "type": "array" },
    "compatibilitySnapshot": { "type": "object" }
  }
}
