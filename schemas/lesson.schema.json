{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamy.tools/codex/schemas/lesson.schema.json",
  "title": "Dreamy Lesson",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "scope",
    "status",
    "trigger",
    "action",
    "evidenceRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
    },
    "scope": {
      "const": "project"
    },
    "status": {
      "enum": [
        "candidate",
        "verified-local",
        "approved",
        "stale",
        "rejected",
        "superseded"
      ]
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "applicability": {
      "type": "object",
      "properties": {
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "nonApplicability": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
