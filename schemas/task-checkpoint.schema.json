{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamy.tools/codex/schemas/task-checkpoint.schema.json",
  "title": "Dreamy Task Checkpoint",
  "type": "object",
  "required": [
    "schemaVersion",
    "taskId",
    "status",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "blocked",
        "cancelled",
        "complete"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "objective": {
      "type": "string",
      "maxLength": 300
    },
    "nextAction": {
      "type": "string",
      "maxLength": 250
    }
  }
}
