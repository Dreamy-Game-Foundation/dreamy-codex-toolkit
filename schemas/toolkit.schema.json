{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamy.tools/codex/schemas/toolkit.schema.json",
  "title": "Dreamy Toolkit Manifest",
  "type": "object",
  "required": ["schemaVersion", "name", "version", "phase", "sourceLedger", "compatibility", "schemas"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "minLength": 1 },
    "status": { "type": "string" },
    "maturity": {
      "type": "object",
      "required": ["foundation", "installer", "dreamyKnowledge", "unityKnowledge", "harness", "evals"],
      "properties": {
        "foundation": { "type": "string" },
        "installer": { "type": "string" },
        "dreamyKnowledge": { "type": "string" },
        "unityKnowledge": { "type": "string" },
        "harness": { "type": "string" },
        "evals": { "type": "string" }
      }
    },
    "sourceLedger": { "type": "string", "minLength": 1 },
    "compatibility": {
      "type": "object",
      "required": ["dreamyPackages", "unity", "thirdParty"],
      "properties": {
        "dreamyPackages": { "type": "string" },
        "unity": { "type": "string" },
        "thirdParty": { "type": "string" }
      }
    },
    "schemas": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "presets": { "type": "array" },
    "modules": { "type": "array" },
    "gates": { "type": "object" }
  }
}
