#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cmd="${1:-help}"
shift || true

target="."
preset="dreamy-project"
dry_run=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --target)
      target="$2"
      shift 2
      ;;
    --preset)
      preset="$2"
      shift 2
      ;;
    --json)
      shift
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

real_target="$(cd "$target" && pwd)"

ensure_target() {
  test -d "$real_target"
}

validate_preset() {
  test -f "$root/presets/$preset.json"
}

detect_project() {
  ensure_target
  manifest="$real_target/Packages/manifest.json"
  if [[ -f "$manifest" ]]; then
    packages="$(jq -c '.dependencies // {} | with_entries(select(.key | startswith("com.dreamy.")))' "$manifest")"
    engine="unity"
  else
    packages="{}"
    engine="unknown"
  fi

  jq -n \
    --arg engine "$engine" \
    --arg preset "$preset" \
    --argjson packages "$packages" \
    '{schemaVersion:1, engine:{name:$engine}, preset:$preset, packages:($packages | to_entries | map({name:.key, version:.value}))}'
}

state_dir() {
  echo "$real_target/.dreamy-codex"
}

managed_block() {
  sed -n '/<!-- DREAMY-CODEX:START schema=1 -->/,/<!-- DREAMY-CODEX:END -->/p' "$root/templates/AGENTS.managed.md"
}

install_project() {
  ensure_target
  validate_preset || {
    echo "Unknown preset: $preset" >&2
    exit 1
  }
  agents="$real_target/AGENTS.md"
  if [[ -f "$agents" ]] && grep -q '<!-- DREAMY-CODEX:START schema=1 -->' "$agents"; then
    echo "AGENTS.md already contains a Dreamy managed block" >&2
    exit 1
  fi
  profile="$(detect_project)"
  if [[ "$dry_run" == true ]]; then
    jq -n --arg action install --arg target "$real_target" --arg preset "$preset" --argjson profile "$profile" '{action:$action,target:$target,preset:$preset,profile:$profile,dryRun:true}'
    return
  fi

  mkdir -p "$(state_dir)"
  profile_tmp="$(state_dir)/project-profile.json.tmp"
  state_tmp="$(state_dir)/install-state.json.tmp"
  printf '%s\n' "$profile" > "$profile_tmp"
  before_hash=""
  if [[ -f "$agents" ]]; then
    before_hash="$(sha256sum "$agents" | awk '{print $1}')"
    cp "$agents" "$agents.tmp"
    managed_block >> "$agents.tmp"
  else
    managed_block > "$agents.tmp"
  fi
  after_hash="$(sha256sum "$agents.tmp" | awk '{print $1}')"

  jq -n \
    --arg toolkitVersion "$(jq -r '.version' "$root/toolkit.json")" \
    --arg target "$real_target" \
    --arg preset "$preset" \
    --arg before "$before_hash" \
    --arg after "$after_hash" \
    '{schemaVersion:1, toolkitVersion:$toolkitVersion, target:$target, preset:$preset, managedBlocks:["AGENTS.md"], checksums:{before:$before, after:$after}}' \
    > "$state_tmp"

  mv "$profile_tmp" "$(state_dir)/project-profile.json"
  mv "$state_tmp" "$(state_dir)/install-state.json"
  mv "$agents.tmp" "$agents"

  jq -n --arg action install --arg target "$real_target" --arg preset "$preset" '{action:$action,target:$target,preset:$preset,status:"ok"}'
}

uninstall_project() {
  ensure_target
  agents="$real_target/AGENTS.md"
  if [[ "$dry_run" == true ]]; then
    jq -n --arg action uninstall --arg target "$real_target" '{action:$action,target:$target,dryRun:true}'
    return
  fi
  state="$(state_dir)/install-state.json"
  if [[ ! -f "$state" ]]; then
    echo "Missing install state; refusing to remove unowned managed block" >&2
    exit 1
  fi
  if [[ -f "$agents" ]]; then
    start_count="$(grep -c '<!-- DREAMY-CODEX:START schema=1 -->' "$agents" || true)"
    end_count="$(grep -c '<!-- DREAMY-CODEX:END -->' "$agents" || true)"
    if [[ "$start_count" != "1" || "$end_count" != "1" ]]; then
      echo "Malformed Dreamy managed block markers" >&2
      exit 1
    fi
    current_hash="$(sha256sum "$agents" | awk '{print $1}')"
    owned_hash="$(jq -r '.checksums.after' "$state")"
    if [[ "$current_hash" != "$owned_hash" ]]; then
      echo "AGENTS.md checksum drift; refusing uninstall" >&2
      exit 1
    fi
    awk '
      /<!-- DREAMY-CODEX:START schema=1 -->/ {skip=1; next}
      /<!-- DREAMY-CODEX:END -->/ {skip=0; next}
      skip != 1 {print}
    ' "$agents" > "$agents.tmp"
    mv "$agents.tmp" "$agents"
  fi
  jq -n --arg action uninstall --arg target "$real_target" '{action:$action,target:$target,status:"ok"}'
}

case "$cmd" in
  validate)
    "$root/scripts/validate"
    ;;
  detect)
    detect_project
    ;;
  install)
    install_project
    ;;
  uninstall)
    uninstall_project
    ;;
  doctor)
    "$root/scripts/validate" >/dev/null
    detect_project | jq '. + {doctor:{status:"ok"}}'
    ;;
  list)
    jq '{presets, modules, rules, skills}' "$root/toolkit.json"
    ;;
  update)
    jq -n '{action:"update", status:"not-implemented", reason:"No released upgrade path in local baseline"}'
    ;;
  help|*)
    cat <<'EOF'
dreamy-kit commands:
  validate
  detect [--target PATH] [--json]
  install [--target PATH] [--preset NAME] [--dry-run]
  uninstall [--target PATH] [--dry-run]
  doctor [--target PATH] [--json]
  list
  update
EOF
    ;;
esac
